        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('Lire recette brute').item.json.id }}",
            "status": "done",
            "published_date": "={{ $now.format('yyyy-MM-dd') }}",
            "blog_url": "=https://blog.heyanto.fr/articles/{{ $('Parser réponse Gemini').item.json.slug }}",
            "social_posted": "fb,ig"
          }
        },
        "options": {
          "cellFormat": "USER_ENTERED"
        }
      },
      "id": "sheets-update",
      "name": "Marquer publié",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2220,
