        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: 'https://blog.heyanto.fr/images/articles/' + $('Parser réponse Gemini').item.json.slug + '-hero.jpg', caption: $('Parser réponse Gemini').item.json.facebook_post + '\\n\\n📖 La recette complète → https://blog.heyanto.fr/articles/' + $('Parser réponse Gemini').item.json.slug, access_token: $env.META_PAGE_TOKEN }) }}",
        "options": {}
      },
      "id": "facebook-post",
      "name": "Facebook — Poster",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        150
      ]
    },
    {
      "parameters": {
        "method": "POST",
