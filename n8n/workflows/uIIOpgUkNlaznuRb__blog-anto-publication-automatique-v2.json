        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ image_url: 'https://blog.heyanto.fr/images/articles/' + $('Parser réponse Gemini').item.json.slug + '-hero.jpg', caption: $('Parser réponse Gemini').item.json.instagram_caption, access_token: $env.META_ACCESS_TOKEN }) }}",
        "options": {}
      },
      "id": "instagram-create",
      "name": "Instagram — Créer media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
