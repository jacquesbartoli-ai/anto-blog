        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.id }}/comments",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: '📖 La recette complète → https://blog.heyanto.fr/articles/' + $('Parser réponse Gemini').item.json.slug, access_token: $env.META_ACCESS_TOKEN }) }}",
        "options": {}
      },
      "id": "instagram-comment",
      "name": "Instagram — Commenter lien",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.buffer.com/graphql",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.BUFFER_API_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'mutation CreatePost($input: CreatePostInput!) { createPost(input: $input) { ... on PostActionSuccess { post { id status } } ... on UnexpectedError { message } } }', variables: { input: { channelId: $env.BUFFER_LINKEDIN_CHANNEL_ID, schedulingType: 'automatic', mode: 'shareNow', text: $('Parser réponse Gemini').item.json.linkedin_post + '\\n\\n📖 La recette complète → https://blog.heyanto.fr/articles/' + $('Parser réponse Gemini').item.json.slug, assets: { images: [{ url: 'https://blog.heyanto.fr/images/articles/' + $('Parser réponse Gemini').item.json.slug + '-hero.jpg' }] } } } }) }}",
        "options": {}
      },
      "id": "linkedin-buffer",
      "name": "LinkedIn — Poster (Buffer)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        -150
      ]
    }
