---
// GEO — Section Questions/Réponses métier + balisage FAQPage (Schema.org).
// Reprend les vraies interrogations du lecteur ; le JSON-LD rend chaque Q/R
// directement extractible en rich snippet et citable par les moteurs IA.
interface FaqItem {
  question: string;
  answer: string;
}
interface Props {
  faq?: FaqItem[];
}
const { faq } = Astro.props;
const hasFaq = Array.isArray(faq) && faq.length > 0;

const faqJsonLd = hasFaq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---

{hasFaq && (
  <section class="article-faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Questions fréquentes</h2>
    <dl>
      {faq.map((item) => (
        <div class="article-faq__item">
          <dt>{item.question}</dt>
          <dd>{item.answer}</dd>
        </div>
      ))}
    </dl>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
  </section>
)}

<style>
  .article-faq {
    margin: 2.5rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e7ddd3;
  }
  .article-faq h2 {
    margin: 0 0 1rem;
  }
  .article-faq__item {
    margin-bottom: 1.25rem;
  }
  .article-faq dt {
    font-weight: 700;
    font-size: 1.05rem;
    color: #1f1f1f;
    margin-bottom: 0.35rem;
  }
  .article-faq dd {
    margin: 0;
    line-height: 1.6;
    color: #3a3a3a;
  }
</style>
