---
interface Props {
  variant?: 'inline' | 'full';
}

const { variant = 'inline' } = Astro.props;
const apiUrl = 'https://anto-pwa.fly.dev/fr/api/newsletter/subscribe';
---

<div class={`newsletter-form ${variant}`}>
  <div class="newsletter-header">
    {variant === 'full' ? (
      <h1>Newsletter</h1>
      <p class="newsletter-desc">Recevez nos conseils métier, recettes et astuces pour gagner du temps en atelier.</p>
    ) : (
      <h2>Restez informé</h2>
      <p class="newsletter-desc">Recevez nos meilleurs articles directement dans votre boîte mail.</p>
    )}
  </div>

  <form id="newsletter-form" class="newsletter-fields">
    <div class="row row-name">
      <input type="text" name="firstName" placeholder="Prénom" required />
      <input type="text" name="lastName" placeholder="Nom" required />
    </div>
    <div class="row row-email">
      <input type="email" name="email" placeholder="votre@email.com" required />
      <button type="submit">S'inscrire →</button>
    </div>
    <p class="newsletter-notice">Pas de spam. Désinscription en 1 clic.</p>
  </form>

  <div id="newsletter-success" class="newsletter-message success" hidden>
    ✓ Inscription confirmée ! Vérifiez votre boîte mail.
  </div>

  <div id="newsletter-error" class="newsletter-message error" hidden></div>
</div>

<style>
  .newsletter-form {
    margin: 3rem 0 0;
    padding: 2rem;
    background: var(--color-card, #ffffff);
    border-radius: 12px;
  }

  .newsletter-form.inline {
    border: 1px solid var(--color-border, #e8e0d8);
  }

  .newsletter-form.full {
    border: none;
    max-width: 560px;
    margin: 2rem auto;
  }

  .newsletter-header h1,
  .newsletter-header h2 {
    font-family: var(--font-heading, 'Playfair Display', serif);
    color: var(--color-text, #2d2520);
    margin: 0 0 0.5rem;
  }

  .newsletter-header h1 {
    font-size: 2rem;
  }

  .newsletter-header h2 {
    font-size: 1.4rem;
  }

  .newsletter-desc {
    color: #6b5b4f;
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .newsletter-fields .row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .newsletter-fields input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border, #e8e0d8);
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: var(--font-body, 'Inter', sans-serif);
    background: var(--color-bg, #faf9f7);
    color: var(--color-text, #2d2520);
    transition: border-color 0.2s;
  }

  .newsletter-fields input:focus {
    outline: none;
    border-color: var(--color-accent, #8b4513);
  }

  .newsletter-fields button {
    padding: 0.75rem 1.5rem;
    background: var(--color-accent, #8b4513);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--font-body, 'Inter', sans-serif);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s, opacity 0.2s;
  }

  .newsletter-fields button:hover {
    background: var(--color-accent-light, #d4a574);
  }

  .newsletter-fields button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .newsletter-notice {
    font-size: 0.8rem;
    color: #9b8b7f;
    margin: 0.5rem 0 0;
  }

  .newsletter-message {
    padding: 1rem;
    border-radius: 8px;
    font-size: 0.95rem;
    margin-top: 1rem;
  }

  .newsletter-message.success {
    background: #e8f5e9;
    color: #2e7d32;
    border: 1px solid #a5d6a7;
  }

  .newsletter-message.error {
    background: #fbe9e7;
    color: #c62828;
    border: 1px solid #ef9a9a;
  }

  @media (max-width: 600px) {
    .newsletter-fields .row {
      flex-direction: column;
    }

    .newsletter-fields button {
      width: 100%;
    }

    .newsletter-form {
      padding: 1.5rem;
    }
  }
</style>

<script define:vars={{ apiUrl }}>
  const form = document.getElementById('newsletter-form');
  const successEl = document.getElementById('newsletter-success');
  const errorEl = document.getElementById('newsletter-error');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]');
    const originalText = btn.textContent;

    // Reset messages
    errorEl.hidden = true;
    errorEl.textContent = '';

    // Loading state
    btn.textContent = 'Envoi...';
    btn.disabled = true;

    try {
      const formData = new FormData(form);
      const payload = {
        email: formData.get('email'),
        firstName: formData.get('firstName'),
        lastName: formData.get('lastName'),
        source: 'blog',
      };

      const res = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        form.hidden = true;
        successEl.hidden = false;
      } else {
        const data = await res.json();
        errorEl.textContent = data.error || 'Une erreur est survenue. Réessayez.';
        errorEl.hidden = false;
        btn.textContent = originalText;
        btn.disabled = false;
      }
    } catch (err) {
      errorEl.textContent = 'Erreur réseau. Vérifiez votre connexion.';
      errorEl.hidden = false;
      btn.textContent = originalText;
      btn.disabled = false;
    }
  });
</script>
