---
import BaseLayout from './BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import ArticleSummary from '../components/ArticleSummary.astro';
import ArticleFaq from '../components/ArticleFaq.astro';

const { frontmatter } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const modifiedDate = frontmatter.updatedDate || frontmatter.publishedDate;

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  image: new URL(frontmatter.heroImage, Astro.site).href,
  datePublished: frontmatter.publishedDate,
  dateModified: modifiedDate,
  author: {
    '@type': 'Person',
    name: frontmatter.author,
    url: 'https://heyanto.fr/a-propos.html',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Antò',
    url: 'https://heyanto.fr',
    logo: {
      '@type': 'ImageObject',
      url: 'https://heyanto.fr/anto-logo.png',
    },
  },
  mainEntityOfPage: canonicalUrl,
  articleSection: frontmatter.category,
  inLanguage: 'fr-FR',
};
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} image={frontmatter.heroImage}>
  <Fragment slot="head">
    <meta property="article:published_time" content={frontmatter.publishedDate} />
    <meta property="article:modified_time" content={modifiedDate} />
    <meta property="article:author" content={frontmatter.author} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(blogPosting)} />
  </Fragment>
  <article>
    <img class="hero-image" src={frontmatter.heroImage} alt={frontmatter.title} />
    <span class="category-tag">{frontmatter.category}</span>
    <h1>{frontmatter.title}</h1>
    <p class="meta">{frontmatter.publishedDate} — par <a href="https://heyanto.fr/a-propos.html" rel="author" data-cta="article_auteur">{frontmatter.author}</a></p>
    {frontmatter.updatedDate && (
      <p class="meta meta-updated">Mis à jour le {frontmatter.updatedDate}</p>
    )}
    <ArticleSummary summary={frontmatter.summary} />
    <div class="content">
      <slot />
    </div>
    <ArticleFaq faq={frontmatter.faq} />
  </article>
  <NewsletterForm variant="inline" />
</BaseLayout>
