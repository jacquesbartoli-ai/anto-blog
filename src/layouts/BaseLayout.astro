---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = "Blog Antò — Recettes et savoir-faire artisanal", image } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Le Blog Antò</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {image && <meta property="og:image" content={image} />}
  <meta property="og:type" content="article" />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Le Blog Antò" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/images/anto-logo.png" />
  <slot name="head" />
</head>
<body>
  <header>
    <div class="container">
      <a href="/" class="logo-link">
        <img src="/images/anto-logo.png" alt="Antò" class="logo" />
        <span class="logo-text">le blog</span>
      </a>
      <nav>
        <a href="/">Recettes</a>
        <a href="/metier">Métier</a>
        <a href="/newsletter">Newsletter</a>
        <a href="https://heyanto.fr" target="_blank" class="nav-cta">Découvrir Antò →</a>
      </nav>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
  <footer>
    <div class="container">
      <a href="https://heyanto.fr" target="_blank" class="footer-logo-link">
        <img src="/images/anto-logo.png" alt="Antò" class="footer-logo" />
      </a>
      <p>Le copilote IA des artisans de l'alimentaire</p>
      <a href="https://heyanto.fr" target="_blank" class="footer-cta">Essayer Antò gratuitement →</a>
    </div>
  </footer>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
