---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter(a => a.data.type === 'recette')
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Le Blog Antò',
      url: 'https://blog.heyanto.fr',
      inLanguage: 'fr-FR',
      publisher: {
        '@type': 'Organization',
        name: 'Antò',
        url: 'https://heyanto.fr',
        logo: {
          '@type': 'ImageObject',
          url: 'https://heyanto.fr/anto-logo.png',
        },
      },
    },
    {
      '@type': 'Organization',
      name: 'Antò',
      url: 'https://heyanto.fr',
      logo: {
        '@type': 'ImageObject',
        url: 'https://heyanto.fr/anto-logo.png',
      },
    },
  ],
};
---

<BaseLayout title="Les recettes">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteJsonLd)} />
  </Fragment>
  <h1>Les recettes</h1>
  <p class="page-subtitle">
    Le savoir-faire artisanal, une recette à la fois.
  </p>

  <div class="articles-grid">
    {articles.map((article) => (
      <a href={`/articles/${article.id.replace(/\.md$/, '')}`} class="article-card">
        <img src={article.data.heroImage} alt={article.data.title} loading="lazy" />
        <div class="card-content">
          <span class="category-tag">{article.data.category}</span>
          <h2>{article.data.title}</h2>
          <p>{article.data.description}</p>
        </div>
      </a>
    ))}
  </div>

  {articles.length === 0 && (
    <p class="empty-state">Les premières recettes arrivent bientôt.</p>
  )}
</BaseLayout>
