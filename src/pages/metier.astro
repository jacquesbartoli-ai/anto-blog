---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter(a => a.data.type === 'metier')
  .sort((a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime());
---

<BaseLayout title="Les articles métier">
  <h1>Les articles métier</h1>
  <p class="page-subtitle">
    Coulisses de l'atelier, convictions et réalité du terrain.
  </p>

  <div class="articles-grid">
    {articles.map((article) => (
      <a href={`/articles/${article.id.replace(/\.md$/, '')}`} class="article-card">
        <img src={article.data.heroImage} alt={article.data.title} loading="lazy" />
        <div class="card-content">
          <span class="category-tag">{article.data.category}</span>
          <h2>{article.data.title}</h2>
          <p>{article.data.description}</p>
        </div>
      </a>
    ))}
  </div>

  {articles.length === 0 && (
    <p class="empty-state">Les articles métier arrivent bientôt.</p>
  )}
</BaseLayout>
